appId: com.beboss.desktop
productName: BeBoss
asar: true
files:
  - dist/**/*
  - electron/**/*
  - package.json
directories:
  output: dist-installers
win:
  target:
    - nsis
nsis:
  oneClick: false
  allowToChangeInstallationDirectory: true
  createDesktopShortcut: true
  createStartMenuShortcut: true
mac:
  target:
    - dmg
  category: public.app-category.business
linux:
  target:
    - AppImage
  category: Office
