{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeBoss",
  "version": "1.4.2",
  "identifier": "com.beboss.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BeBoss Desktop",
        "width": 1540,
        "height": 980,
        "minWidth": 760,
        "minHeight": 720,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: asset: https://asset.localhost; font-src 'self' data: https://fonts.gstatic.com; connect-src ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co https://*.ingest.sentry.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "appimage"
    ],
    "copyright": "Copyright (c) 2024 BeBoss Retail Operations",
    "homepage": "https://beboss.rw",
    "license": "LICENSE.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "shortDescription": "BeBoss retail operations platform",
    "longDescription": "Offline-first retail operating system with point of sale, inventory, purchasing, customer credit, supplier workflows, sales analytics, multi-branch operations, staff access, POS device management, stock transfers, subscription billing, encrypted backups, diagnostics and verified cloud synchronization.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English",
          "French"
        ],
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "BeBoss",
        "installerHooks": "installer-hooks.nsh",
        "uninstallerHeaderImage": "installer/header.bmp"
      },
      "wix": {
        "language": "en-US"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    }
  },
  "mainBinaryName": "BeBoss"
}
