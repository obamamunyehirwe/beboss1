{
  "name": "beboss-desktop",
  "version": "1.4.2",
  "private": true,
  "description": "BeBoss desktop retail operations client",
  "type": "module",
  "scripts": {
    "sync:assets": "node scripts/sync-assets.mjs",
    "dev": "tauri dev",
    "dev:ui": "npm run sync:assets && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build:web": "npm run check:versions && npm run sync:assets && vite build",
    "build": "npm run build:web",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "tauri dev",
    "dist": "tauri build",
    "dist:win": "tauri build --bundles nsis",
    "dist:mac": "tauri build --bundles dmg",
    "dist:linux": "tauri build --bundles appimage",
    "check:versions": "node scripts/check-version-coherence.mjs",
    "check:types": "tsc --noEmit -p tsconfig.desktop.json",
    "test": "node --experimental-strip-types --test src/lib/device-restore.test.ts src/lib/snapshot-merge.test.ts src/lib/cloud-request.test.ts",
    "sign:win:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-windows-installer.ps1",
    "release:win:local": "npm run check:versions && npm run check:installer && npm run check:types && npm test && cargo test --locked --manifest-path src-tauri/Cargo.toml && npm run dist:win && npm run sign:win:local && node scripts/generate-bundle-checksums.mjs src-tauri/target/release/bundle/nsis",
    "check:installer": "node scripts/check-installer-config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.2.7",
    "lucide-react": "^0.575.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.3",
    "vite": "^8.3.0"
  }
}
