{
  "name": "beboss-desktop",
  "version": "1.2.1",
  "private": true,
  "description": "BeBoss desktop retail operations client",
  "type": "module",
  "scripts": {
    "sync:assets": "node scripts/sync-assets.mjs",
    "dev": "tauri dev",
    "dev:ui": "npm run sync:assets && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build:web": "npm run sync:assets && tsc --noEmit && vite build",
    "build": "npm run build:web",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "tauri dev",
    "dist": "tauri build",
    "dist:win": "tauri build --bundles nsis",
    "dist:mac": "tauri build --bundles dmg",
    "dist:linux": "tauri build --bundles appimage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.2.7",
    "lucide-react": "^0.575.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.0"
  }
}
