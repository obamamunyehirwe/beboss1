# BeBoss Supabase project public configuration.
# Copy to desktop/.env.local. This key is public and is safe for client use.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Do not add service-role keys, secret keys, payment-provider secrets, or the
# BBSHARE HMAC secret to any VITE_ variable or desktop environment file.

