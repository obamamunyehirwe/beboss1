# BeBoss production Supabase project. These values are safe to publish when used as directed.
SUPABASE_URL=https://ahlpvlhmpfiyeoercxol.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_project_key

# Legacy anon JWT retained for the Android BuildConfig wiring.
SUPABASE_ANON_KEY=replace_with_android_anon_key

# Server-only. Never expose to Vite, the browser, or Android.
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

# Required server-side secrets: generate distinct, high-entropy values.
# BB3 P-256 private key is stored only in Supabase public.app_secrets as
# BEBOSS_UNLOCK_ECDSA_PRIVATE_KEY_PEM. Never add it to this file, VITE_ variables, or Android.
BEBOSS_SECURITY_PEPPER=generate_a_separate_random_secret
BEBOSS_DATASHARE_HMAC_SECRET=generate_a_separate_random_secret
BEBOSS_LAN_SYNC_SECRET=generate_a_separate_random_secret
BEBOSS_ADMIN_WHATSAPP=your_verified_support_number

# Optional invite email redirect. Add exact URL to Supabase Auth Redirect URLs.
BEBOSS_ADMIN_URL=https://admin.beboss.rw/reset-password?invite=1

# Optional monitoring.
SUPABASE_CERT_PINS=none
SENTRY_DSN=
