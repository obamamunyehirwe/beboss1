BEBOSS_ADMIN_WHATSAPP=your_whatsapp_number_here
BEBOSS_DATASHARE_HMAC_SECRET=your_datashare_hmac_secret_here
BEBOSS_LAN_SYNC_SECRET=your_lan_sync_secret_here
BEBOSS_SECURITY_PEPPER=your_security_pepper_here
BEBOSS_UNLOCK_SIGNING_SECRET=your_unlock_signing_secret_here
SUPABASE_ADMIN_EMAIL=your_admin_email_here
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_CERT_PINS=none
SUPABASE_URL=https://your-project-id.supabase.co

# BeBoss web server (Vercel / TanStack Start).
# The Vite config exposes only SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY to the browser.
# These public values are safe in a client bundle when database/storage RLS policies are enabled.
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only privileged key used by trusted server handlers. NEVER add a VITE_ prefix.
# Never copy this value into the Android app, browser, or public repository.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Optional explicit browser overrides. When omitted, the Vite build maps the public server
# values above to these VITE_ bindings automatically.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
