BEBOSS_ADMIN_URL=
BEBOSS_ADMIN_WHATSAPP=
# Server-only legacy DataShare verifier. Never build this value into Android.
BEBOSS_DATASHARE_HMAC_SECRET=
# TransitionRelease only: migrate old PBKDF2-v1 staff hashes into device Keystore.
# Remove after the one-time migration; SecureRelease does not package this value.
BEBOSS_SECURITY_PEPPER=
# Public Sentry project DSN used by Android release crash/ANR telemetry.
SENTRY_DSN=
SUPABASE_ANON_KEY=
# Generate real SPKI pins for this exact SUPABASE_URL with: java ./scripts/PrintSupabaseTlsPins.java --update-env
SUPABASE_CERT_PINS=
SUPABASE_PUBLISHABLE_KEY=
# Preferred server-only Supabase secret API key. Never use a VITE_ prefix.
SUPABASE_SECRET_KEY=
# Backward-compatible fallback for deployments still using the legacy key.
SUPABASE_SERVICE_ROLE_KEY=
# Public Android client configuration. Secure release builds require all three values below:
# - HTTPS Supabase project URL
# - sb_publishable_... key (or a legacy anon JWT whose role is anon; never a service-role key)
# - Comma-separated SHA-256 TLS certificate pins in OkHttp format: sha256/<base64 SHA-256 digest>
SUPABASE_URL=

# Server-only payment provider secrets (configure as Supabase Edge Function secrets).
# Never expose these as VITE_* values or embed them in Android builds.
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET_HASH=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BEBOSS_PUBLIC_URL=

# Android production signing only. This is a self-managed APK/AAB signing key; Google Play is not required.
# ANDROID_RELEASE_CERT_SHA256 is the expected SHA-256 fingerprint of the certificate in KEYSTORE_PATH.
# ANDROID_UPLOAD_CERT_SHA256 remains a backward-compatible alias for older release environments.
# Keep the keystore and passwords outside Git and supply them only through protected local/CI secrets.
# Existing production installs: set SECURE_CREDENTIAL_MIGRATION_APPROVED=true only after every active terminal
# has completed Transition 2.4.1 and reported its legacy credential pepper secured in Android Keystore.
# First customer production release ONLY: set ANDROID_FIRST_PRODUCTION_RELEASE=true when no customer
# production APK is installed and no legacy credential backup containing v1 staff hashes will be imported.
# Never use the first-production flag to bypass migration on an existing customer install base.
# Relative KEYSTORE_PATH values are resolved from the repository root.
KEYSTORE_PATH=
STORE_PASSWORD=
KEY_PASSWORD=
KEY_ALIAS=
ANDROID_RELEASE_CERT_SHA256=74239C5863FA312DF2920844D40FF167DDC88B821A75D0A2FCFE316BF81740D4
ANDROID_UPLOAD_CERT_SHA256=
SECURE_CREDENTIAL_MIGRATION_APPROVED=false
ANDROID_FIRST_PRODUCTION_RELEASE=false

# Africa's Talking Supabase Auth Send SMS Hook (server-only)
SEND_SMS_HOOK_SECRET=
AFRICASTALKING_ENV=sandbox
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=

# MTN MoMo Collection API. Configure only as Supabase Edge Function secrets.
# Sandbox uses its legacy API User + API Key credentials.
MTN_MOMO_ENV=sandbox
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_COLLECTIONS_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
# Rwanda production uses the new MoMo host and Partner Portal System Credentials.
# Select production, set the base URL to https://momoapi.momo.africa and target to mtnrwanda.
MTN_MOMO_USER_ID=
MTN_MOMO_CREDENTIAL_TOKEN=

# Airtel Money Rwanda API (server-only merchant credentials)
AIRTEL_MONEY_ENV=sandbox
AIRTEL_MONEY_BASE_URL=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_COUNTRY=RW
AIRTEL_MONEY_CURRENCY=RWF
AIRTEL_MONEY_CALLBACK_URL=
